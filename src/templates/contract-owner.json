{
  "id": "contract-owner",
  "name": "Contract owner",
  "kind": "contract-tools Owner",
  "roleTitle": "Contract\nowner",
  "description": "The Writ's executor holds the owner role. Its current NFT holder can exercise that authority.",
  "blindSpot": "These checks cover the declared owner and proposed owner. They do not discover hidden permissions, upgrade keys or backdoors in the target contract. External state may change after it is read.",
  "checks": [
    {
      "id": "owner",
      "label": "Owner is the Writ account",
      "method": "own_get_owner",
      "target": "role",
      "pointer": "",
      "operator": "eq",
      "expected": "$WRIT"
    },
    {
      "id": "proposed",
      "label": "No next owner proposed",
      "method": "own_get_proposed_owner",
      "target": "role",
      "pointer": "",
      "operator": "null",
      "expected": null
    }
  ],
  "pins": [
    {
      "id": "minimum_balance",
      "label": "Minimum executor balance",
      "method": "get_balance",
      "target": "executor",
      "operator": "gte",
      "unit": "NEAR"
    }
  ],
  "actions": [
    {
      "method": "set_price",
      "label": "Set the service price",
      "args": { "price": "1" },
      "maxDeposit": "0",
      "lendable": true
    },
    {
      "method": "own_propose_owner",
      "label": "Propose a different owner",
      "args": { "account_id": null },
      "maxDeposit": "0",
      "lendable": false
    }
  ],
  "wrapSteps": [
    {
      "label": "Propose the executor as owner",
      "method": "own_propose_owner",
      "signer": "holder"
    },
    {
      "label": "Accept from the executor",
      "method": "own_accept_owner",
      "signer": "executor"
    }
  ],
  "supportsUnwrap": true
}
